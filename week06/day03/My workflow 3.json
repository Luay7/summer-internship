      "parameters": {
        "promptType": "define",
        "text": "={{ $json.user_request }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a request extraction agent.\n\nExtract exactly two values from the user's request:\n\n1. country:\n   The country mentioned by the user.\n   Return the country name in English.\n\n2. target_currency:\n   The currency that the user explicitly wants to compare the country's currency TO.\n   Return it as a 3-letter ISO currency code.\n\nIMPORTANT:\n- target_currency is NOT the currency of the country.\n- Do NOT determine or guess the country's own currency.\n- If the user says \"compare it to USD\", target_currency MUST be \"USD\".\n- If the user says \"against EUR\", target_currency MUST be \"EUR\".\n- Do not answer the question.\n- Do not provide exchange rates.\n- Do not calculate anything.\n- Return only valid JSON.\n\nExample:\n\nUser:\nGet the currency of Saudi Arabia and compare it to USD\n\nOutput:\n{\n  \"country\": \"Saudi Arabia\",\n  \"target_currency\": \"USD\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        128,
        0
      ],
      "id": "feaa33f4-06a7-4667-890d-9a52a9c8c2d5",
