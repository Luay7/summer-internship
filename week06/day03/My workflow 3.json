        "messages": {
          "messageValues": [
            {
              "message": "=Create a short final answer using the following data.\n\nCountry:\n{{ $('AI Agent').item.json.output.country }}\n\nBase currency:\n{{ $json.base_code }}\n\nTarget currency:\n{{ $('AI Agent').item.json.output.target_currency }}\n\nExchange rate:\n{{ $json.rates[$('AI Agent').item.json.output.target_currency] }}\n\nRules:\n- State the country's currency.\n- State the exchange rate as: 1 BASE = RATE TARGET.\n- Do not calculate any amount.\n- Do not add extra explanation.\n- Maximum two sentences."
            }
          ]
        },
